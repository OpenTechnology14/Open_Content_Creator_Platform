{
  "_meta": {
    "title": "Realtime LCM Stylization v1",
    "description": "SD 1.5 + LCM-LoRA 2-4 step stylization for webcam frames. Target: 8-20 fps on RTX 30/40 series.",
    "module": "realtime-ai",
    "status": "template — customize prompt and LoRA to your style"
  },
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "webcam_frame.png"
    }
  },
  "2": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "v1-5-pruned-emaonly.safetensors"
    }
  },
  "3": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["2", 0],
      "clip": ["2", 1],
      "lora_name": "lcm-lora-sdv1-5.safetensors",
      "strength_model": 1.0,
      "strength_clip": 1.0
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "oil painting style, vibrant colors, artistic",
      "clip": ["3", 1]
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, lowres, watermark, text",
      "clip": ["3", 1]
    }
  },
  "6": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["1", 0],
      "vae": ["2", 2]
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "seed": 42,
      "steps": 4,
      "cfg": 1.5,
      "sampler_name": "lcm",
      "scheduler": "sgm_uniform",
      "denoise": 0.5
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["2", 2]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "realtime_styled"
    }
  }
}
