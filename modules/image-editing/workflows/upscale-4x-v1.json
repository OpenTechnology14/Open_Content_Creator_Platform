{
  "_meta": {
    "title": "Upscale 4x v1",
    "description": "Detail-preserving 4x upscale: a fast 4x-UltraSharp ESRGAN pass for resolution, then a light SDXL tile-diffusion pass (low denoise) for detail the ESRGAN model alone can't add. Node name and IO verified against the UltimateSDUpscale project (2026-09-01 web search).",
    "module": "image-editing",
    "status": "GPU-run verified 2026-09-02 on Apple M1 Pro/Metal (P-043) — loaded into a real ComfyUI and produced a correctly-sized 4x output. UltimateSDUpscale required two inputs (tiled_decode, batch_size) this file was missing, fixed here.",
    "required_models": ["4x-UltraSharp.pth", "SDXL base"],
    "required_nodes": ["UltimateSDUpscale (ssitu/ComfyUI_UltimateSDUpscale)"]
  },
  "1": {
    "class_type": "LoadImage",
    "_note": "Injected at runtime by the caller.",
    "inputs": {
      "image": "PLACEHOLDER_IMAGE"
    }
  },
  "2": {
    "class_type": "UpscaleModelLoader",
    "_note": "Built-in ComfyUI core node.",
    "inputs": {
      "model_name": "4x-UltraSharp.pth"
    }
  },
  "3": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "highly detailed, sharp focus, high quality",
      "clip": ["3", 1]
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, lowres, artifacts, oversharpened, watermark",
      "clip": ["3", 1]
    }
  },
  "6": {
    "class_type": "UltimateSDUpscale",
    "_note": "Low denoise — this is a detail pass on top of the ESRGAN upscale, not a re-generation.",
    "inputs": {
      "image": ["1", 0],
      "model": ["3", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "vae": ["3", 2],
      "upscale_model": ["2", 0],
      "upscale_by": 4.0,
      "seed": 0,
      "steps": 20,
      "cfg": 5.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.2,
      "mode_type": "Linear",
      "tile_width": 1024,
      "tile_height": 1024,
      "mask_blur": 8,
      "tile_padding": 32,
      "seam_fix_mode": "None",
      "seam_fix_denoise": 0,
      "seam_fix_width": 64,
      "seam_fix_mask_blur": 8,
      "seam_fix_padding": 16,
      "force_uniform_tiles": true,
      "tiled_decode": false,
      "batch_size": 1
    }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "upscale_4x"
    }
  }
}
