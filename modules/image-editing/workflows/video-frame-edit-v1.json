{
  "_meta": {
    "title": "Video Frame Edit v1",
    "description": "Extract a single frame from a video, apply inpainting, re-insert the edited frame. Requires VideoHelperSuite custom node pack.",
    "module": "image-editing",
    "status": "template — customize model and prompt per edit",
    "required_nodes": ["VideoHelperSuite"]
  },
  "1": {
    "class_type": "VHS_LoadVideo",
    "_note": "VideoHelperSuite LoadVideo node. Loads a video file.",
    "inputs": {
      "video": "input_video.mp4",
      "force_rate": 0,
      "force_size": "Disabled",
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "2": {
    "class_type": "VHS_SelectEveryNthFrame",
    "_note": "Extract a single frame by index.",
    "inputs": {
      "images": ["1", 0],
      "select_every_nth": 1,
      "skip_first_frames": 0
    }
  },
  "3": {
    "class_type": "LoadImage",
    "_note": "Load the user-drawn mask for the region to edit.",
    "inputs": {
      "image": "mask.png"
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd_xl_base_1.0_inpainting_0.1.safetensors"
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "describe what should fill the masked area",
      "clip": ["4", 1]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, lowres, artifacts, watermark",
      "clip": ["4", 1]
    }
  },
  "7": {
    "class_type": "VAEEncodeForInpaint",
    "inputs": {
      "pixels": ["2", 0],
      "mask": ["3", 0],
      "vae": ["4", 2],
      "grow_mask_by": 8
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["5", 0],
      "negative": ["6", 0],
      "latent_image": ["7", 0],
      "seed": 42,
      "steps": 25,
      "cfg": 7.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.85
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["8", 0],
      "vae": ["4", 2]
    }
  },
  "10": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["9", 0],
      "filename_prefix": "edited_frame"
    }
  }
}
