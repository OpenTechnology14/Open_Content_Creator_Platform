# Open Content Creator Platform — environment variables
#
# Copy to .env and fill in real values.
# .env is gitignored. .env.example is the source of truth for what must exist.

# ──────────────────────────────────────────
# Core
# ──────────────────────────────────────────
LOG_LEVEL=INFO
HCP_API_KEY=change-me-to-a-long-random-string

# ──────────────────────────────────────────
# Postgres (local container)
# Override DATABASE_URL when using DO Managed PostgreSQL
# ──────────────────────────────────────────
POSTGRES_DB=hcp
POSTGRES_USER=hcp
POSTGRES_PASSWORD=change-me

# Standalone relay: bootstrap credentials are never used by the API.
# Set a real runtime password and use the same value in the connection URL.
# The hostname 'postgres' is the relay Compose service, not the creator workstation.
RELAY_DATABASE_PASSWORD=replace-me-with-a-runtime-password
RELAY_DATABASE_URL=postgresql+asyncpg://relay_app:replace-me-with-a-runtime-password@postgres:5432/relay
RELAY_ENVIRONMENT=production
# Production refuses this placeholder; supply an operator-generated signing secret before hosting.
RELAY_JWT_SECRET=change-me-in-production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Used by FastAPI; on DO override with managed-DB connection string:
# DATABASE_URL=postgresql+asyncpg://USER:PASS@db-host.db.ondigitalocean.com:25060/hcp?ssl=require
DATABASE_URL=postgresql+asyncpg://hcp:change-me@postgres:5432/hcp

# ──────────────────────────────────────────
# Redis (local container)
# Override when using DO Managed Redis
# ──────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ──────────────────────────────────────────
# MinIO (local) — and DO Spaces (cloud)
# Use the same env vars; only endpoint + secure change.
# ──────────────────────────────────────────
MINIO_ROOT_USER=hcpadmin
MINIO_ROOT_PASSWORD=change-me-long
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_REGION=us-east-1

# When deploying to DigitalOcean, these override the local MinIO values.
# Required by docker-compose.digitalocean.yml (docker compose config fails
# without them, even locally, if you ever validate that overlay) — that gap
# is documented in docs/AUDIT.md and closed here. Uncomment MINIO_* above
# instead of these three when running the local-only stack.
SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
SPACES_ACCESS_KEY=change-me
SPACES_SECRET_KEY=change-me-long
SPACES_REGION=nyc3

# ──────────────────────────────────────────
# Grafana
# ──────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change-me

# ──────────────────────────────────────────
# OBS WebSocket — creator-experience / automation-control
# Used by automation scripts on the workstation
# ──────────────────────────────────────────
OBS_WEBSOCKET_HOST=localhost
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_PASSWORD=change-me

# ──────────────────────────────────────────
# n8n — automation-control
# ──────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=change-me

# ──────────────────────────────────────────
# ComfyUI (Guides 4, 4B, 5)
# Used by Krita scripts, webcam bridge, burst worker
# ──────────────────────────────────────────
COMFYUI_URL=http://127.0.0.1:8188

# ──────────────────────────────────────────
# Ollama — ai-agents
# ──────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=24h

# Stream Autopilot host — optional native worker; uses HCP_API_KEY above.
# Run on the workstation and point this at the authenticated local backend.
AUTOPILOT_BACKEND_URL=http://127.0.0.1:8000
# Optional P-056 Twitch EventSub chat ingress. Store real values only in local .env.
TWITCH_CLIENT_ID=
TWITCH_USER_ACCESS_TOKEN=

# ──────────────────────────────────────────
# Tailscale — infrastructure
# Used by deployment scripts; do NOT commit a real key
# ──────────────────────────────────────────
TAILSCALE_AUTHKEY=

# ──────────────────────────────────────────
# DigitalOcean deployment (optional)
# ──────────────────────────────────────────
DO_DROPLET_IP=
DO_SSH_USER=root

# Optional test-only URL for the explicit ignored Creator workflow image round-trip test.
# HCP_COMFYUI_ACCEPTANCE_URL=http://127.0.0.1:8188

# Optional module installer/checker data directory. Desktop apps set this internally.
# CLI defaults to the repository; do not copy virtual environments between OSes.
# HCP_MODULE_DATA_ROOT=/absolute/path/to/shared/module-setup
# Social Management provider application registration. Access/refresh tokens and stream keys are
# stored in the OS credential manager and must never be added here.
SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_TWITCH_CLIENT_ID=
SOCIAL_TWITCH_CLIENT_SECRET=
SOCIAL_X_CLIENT_ID=
SOCIAL_DISCORD_CLIENT_ID=
SOCIAL_DISCORD_CLIENT_SECRET=
