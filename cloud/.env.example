# Cloud Relay — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# ── Required ──────────────────────────────────────────────────
RELAY_JWT_SECRET=change-me-use-at-least-32-random-characters
POSTGRES_PASSWORD=change-me

# ── Database (auto-set if using docker-compose.relay.yml) ─────
RELAY_DATABASE_URL=postgresql+asyncpg://relay:${POSTGRES_PASSWORD}@postgres:5432/relay
RELAY_REDIS_URL=redis://redis:6379/0
RELAY_ENVIRONMENT=production

# ── Stripe (for subscription billing) ────────────────────────
# RELAY_STRIPE_SECRET_KEY=sk_live_...
# RELAY_STRIPE_WEBHOOK_SECRET=whsec_...
# RELAY_STRIPE_PRICE_CONNECT=price_...
# RELAY_STRIPE_PRICE_PRO=price_...
# RELAY_STRIPE_PRICE_TEAM=price_...

# ── DigitalOcean Spaces (S3-compatible asset storage) ─────────
# RELAY_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# RELAY_SPACES_REGION=nyc3
# RELAY_SPACES_BUCKET=hcp-assets
# RELAY_SPACES_ACCESS_KEY=
# RELAY_SPACES_SECRET_KEY=

# ── Push Notifications ────────────────────────────────────────
# iOS (APNs)
# RELAY_APNS_KEY_PATH=/path/to/AuthKey.p8
# RELAY_APNS_KEY_ID=ABC123
# RELAY_APNS_TEAM_ID=DEF456

# Android (FCM)
# RELAY_FCM_CREDENTIALS_JSON=/path/to/firebase-adminsdk.json

# ── App Store Receipt Verification ────────────────────────────
# RELAY_APPLE_SHARED_SECRET=
# RELAY_GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/google-play-service-account.json
