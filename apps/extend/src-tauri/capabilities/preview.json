{
  "identifier": "preview",
  "description": "Local preview window: shared setup, profile selection and recording file selection. No OAuth, remote or publishing grants.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "module-setup:default",
    "social-manager:allow-snapshot",
    "social-manager:allow-selection",
    "social-manager:allow-activate-profile",
    "allow-production-status",
    "allow-production-start-recording",
    "allow-production-stop-recording",
    "allow-production-recover",
    "allow-production-scenes",
    "allow-production-switch-scene",
    "allow-production-audio-inputs",
    "allow-production-set-mute",
    "allow-preview-preferences",
    "allow-preview-save-preferences",
    "allow-preview-set-obs-password",
    "allow-setup-last-readiness",
    "allow-setup-refresh-readiness",
    "allow-setup-sync-settings",
    "allow-setup-save-sync-settings",
    "allow-setup-sync-now",
    "allow-obs-connection-diagnostic",
    "allow-obs-recording-test",
    "allow-preview-workflows",
    "allow-recordings-list",
    "allow-recordings-import",
    "allow-recordings-update",
    "allow-recordings-reveal",
    "allow-production-abandon-handoff"
  ]
}
