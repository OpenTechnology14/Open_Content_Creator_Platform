{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream Extend",
  "version": "0.1.0",
  "identifier": "com.streamextend.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Stream Extend",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Control your streaming setup from one app",
    "longDescription": "Stream Extend gives you a unified dashboard for OBS, AI effects, overlays, audio monitoring, and AI agents. Desktop + mobile.",
    "macOS": {
      "entitlements": null,
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Open Content Creator Platform"
      }
    },
    "iOS": {
      "developmentTeam": ""
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "notification": null
  }
}
