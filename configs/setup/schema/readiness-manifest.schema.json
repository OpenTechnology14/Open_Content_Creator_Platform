{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hybridcreator.local/schemas/readiness-manifest.schema.json",
  "title": "Hybrid Creator readiness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "product", "checks", "capabilities"],
  "properties": {
    "schema_version": { "const": 1 },
    "manifest_version": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "enum": ["stream-extend", "creator-extend"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/check" }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,149}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "requires"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "requires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
